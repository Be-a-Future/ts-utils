{
  "name": "@bafx/utils",
  "version": "1.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Be-a-Future/ts-utils.git"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build:code": "tsc",
    "build:docs": "typedoc --out docs src/index.ts --includeVersion",
    "build": "npm run build:code && npm run  build:docs",
    "test": "jest",
    "testWithCoverage": "jest --ci --reporters=default --reporters=jest-junit --coverage --coverageReporters=cobertura",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "npm run lint && npm run build && npm run test",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@bafx/lint-config": "^3.0.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.14",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "volta": {
    "node": "26.10.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
