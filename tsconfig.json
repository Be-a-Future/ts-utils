{
  "compilerOptions": {
    "strict": true,
    "target": "es5",
    "lib": ["es2017"],
    "outDir": "./build",
    "rootDir": "./src",
    "module": "commonjs",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/*"
  ]
}
